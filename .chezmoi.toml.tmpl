{{- $desktop := promptBoolOnce . "desktop" "Install desktop environment" true -}}
{{- $denopsSharedServer := promptBoolOnce . "denopsSharedServer" "Start a Denops shared server at login" false -}}
{{- $zennPreview := promptBoolOnce . "zennPreview" "Start Zenn preview on Tailscale at login" false -}}
{{- $email := promptStringOnce . "email" "Enter your Git email address" "peloeil20@gmail.com" -}}
{{- $researchEmail := promptStringOnce . "researchEmail" "Enter your research Git email address" -}}
{{- $researchDir := promptStringOnce . "researchDir" "Enter your research directory (absolute path or ~/...)" (joinPath .chezmoi.homeDir "workspace/university/laboratory/research") -}}
{{- $name := promptStringOnce . "name" "Enter your Git full name" "Shun Ota" -}}
encryption = "age"

[data]
  desktop = {{ $desktop }}
  denopsSharedServer = {{ $denopsSharedServer }}
  denopsServerPort = {{ get . "denopsServerPort" | default 32123 | int }}
  zennPreview = {{ $zennPreview }}
  email = "{{ $email }}"
  researchEmail = "{{ $researchEmail }}"
  researchDir = {{ $researchDir | quote }}
  name = "{{ $name }}"

[age]
  identity = "~/.config/chezmoi/key.txt"
  recipient = "age1erycv24ut8hjkeujqu087hukdpkwy0stse4lvc2dx6e3w4mqr9es5j522h"

[edit]
  command = "nvim"
