#!/bin/sh
set -eu

{{ if eq .chezmoi.os "linux" -}}
# Debian/Ubuntuベースのシステム向け
if command -v apt-get >/dev/null; then
  echo "Debian/Ubuntu向けの前提条件をインストールします..."
  # sudo権限が必要な操作。sudo不要の環境では、これらのツールが事前にインストールされていることを前提とする。
  if command -v sudo >/dev/null 2>&1 && sudo -v; then
    sudo apt-get update
{{- if eq (get . "profile" | default "full") "minimal" }}
    sudo apt-get install -y \
      bison binutils build-essential curl elfutils file git libncurses-dev procps psmisc unzip
{{- else }}
    sudo apt-get install -y \
      alacritty \
      bison \
      binutils \
      blueman \
      build-essential \
      curl \
      elfutils \
      fcitx5 \
      fcitx5-config-qt \
      fcitx5-frontend-gtk3 \
      fcitx5-frontend-gtk4 \
      fcitx5-frontend-qt5 \
      fcitx5-mozc \
      feh \
      file \
      fonts-ipaexfont \
      flameshot \
      fontconfig \
      git \
      i3-wm \
      i3lock \
      libncurses-dev \
      network-manager-gnome \
      picom \
      polybar \
      procps \
      psmisc \
      pulseaudio-utils \
      rofi \
      unzip \
      x11-xserver-utils \
      xbacklight \
      xclip \
      xfonts-base \
      xfonts-intl-japanese \
      xinit \
      xinput \
      xserver-xorg \
      xss-lock
{{- end }}
  else
    echo "sudo権限がないため、前提パッケージ導入をスキップします。残りのセットアップは続行します。"
  fi
fi

# Arch Linux向け
if command -v pacman >/dev/null; then
  echo "Arch Linux向けの前提条件をインストールします..."
  if command -v sudo >/dev/null 2>&1 && sudo -v; then
{{- if eq (get . "profile" | default "full") "minimal" }}
    sudo pacman -Syu --noconfirm --needed \
      binutils curl elfutils git libarchive procps-ng psmisc unzip
{{- else }}
    sudo pacman -Syu --noconfirm --needed \
      alacritty \
      binutils \
      curl \
      fcitx5 \
      fcitx5-configtool \
      fcitx5-gtk \
      fcitx5-mozc \
      fcitx5-qt \
      feh \
      fontconfig \
      flameshot \
      git \
      i3-wm \
      i3lock \
      blueman \
      elfutils \
      libarchive \
      network-manager-applet \
      otf-ipaexfont \
      picom \
      polybar \
      procps-ng \
      psmisc \
      pulseaudio \
      rofi \
      unzip \
      xclip \
      xorg-fonts-misc \
      xorg-xinput \
      xorg-server \
      xorg-xbacklight \
      xorg-xinit \
      xorg-xset \
      xss-lock
{{- end }}
  else
    echo "sudo権限がないため、前提パッケージ導入をスキップします。残りのセットアップは続行します。"
  fi
fi

# Gentoo向け
# kernel config を変更することを忘れない
if command -v emerge >/dev/null; then
  echo "Gentoo向けの前提条件をインストールします..."
  if command -v sudo >/dev/null 2>&1 && sudo -v; then
{{- if eq (get . "profile" | default "full") "minimal" }}
    sudo emerge --noreplace \
      app-arch/libarchive app-arch/unzip dev-libs/elfutils dev-vcs/git \
      net-misc/curl sys-devel/binutils sys-process/procps sys-process/psmisc
{{- else }}
    sudo emerge --noreplace \
      app-arch/libarchive \
      app-arch/unzip \
      app-i18n/fcitx \
      app-i18n/fcitx-configtool \
      app-i18n/fcitx-gtk \
      app-i18n/fcitx-qt \
      'app-i18n/mozc[fcitx5]' \
      dev-libs/elfutils \
      sys-devel/binutils \
      dev-vcs/git \
      gnome-extra/nm-applet \
      media-gfx/feh \
      media-gfx/flameshot \
      media-fonts/font-misc-misc \
      media-fonts/ipaex \
      media-libs/fontconfig \
      media-libs/libpulse \
      net-misc/curl \
      net-wireless/blueman \
      sys-process/procps \
      sys-process/psmisc \
      x11-apps/xbacklight \
      x11-apps/xinput \
      x11-apps/xinit \
      x11-apps/xset \
      x11-base/xorg-server \
      x11-misc/i3lock \
      x11-misc/picom \
      x11-misc/polybar \
      x11-misc/rofi \
      x11-misc/xclip \
      x11-misc/xss-lock \
      x11-terms/alacritty \
      x11-wm/i3
{{- end }}
  else
    echo "sudo権限がないため、前提パッケージ導入をスキップします。残りのセットアップは続行します。"
  fi
fi
{{ end -}}
