#!/bin/sh
set -eu

# Re-run when the managed tool configuration changes.
# mise_config_sha256={{ include "dot_config/mise/config.toml" | sha256sum }}

echo "check if all the mise tools are installed..."
~/.local/bin/mise install --yes

if uv_path="$(~/.local/bin/mise which uv 2>/dev/null)"; then
  "$uv_path" python install --default
else
  echo "uv not installed; skipping python install." >&2
fi
