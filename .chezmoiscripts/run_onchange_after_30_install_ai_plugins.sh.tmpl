#!/bin/sh
set -eu

mise_path="{{ .chezmoi.homeDir }}/.local/bin/mise"
codex_path="{{ .chezmoi.homeDir }}/.local/bin/codex"

if [ -x "$codex_path" ]; then
	"$codex_path" plugin marketplace add DietrichGebert/ponytail
	"$codex_path" plugin add ponytail@ponytail
else
	echo "codex not installed; skipping Ponytail plugin install." >&2
fi

if "$mise_path" which claude >/dev/null 2>&1; then
	"$mise_path" exec -- claude plugin marketplace add \
		DietrichGebert/ponytail --scope user
	"$mise_path" exec -- claude plugin install ponytail@ponytail --scope user
else
	echo "claude not installed; skipping Ponytail plugin install." >&2
fi
