# Environment needed in both interactive and non-interactive shells.
# Keep this section quiet so login shells and bash -lc can reuse it safely.

# rustup
if [[ -f "$HOME/.cargo/env" ]] ; then
	. "$HOME/.cargo/env"
fi

# Standalone tools (Codex, uv, mise) take precedence over inherited shims.
export PATH="$HOME/.local/bin:$PATH"

export EDITOR="nvim"
export VISUAL="nvim"

# Non-interactive shells need shims; interactive shells use prompt hooks.
if command -v mise >/dev/null 2>&1 ; then
	if [[ $- == *i* ]] ; then
		eval "$(mise activate bash)"
	else
		eval "$(mise activate bash --shims)"
	fi
fi

export PATH="$HOME/.local/bin:$PATH"

# Interactive-only configuration belongs below this point.
if [[ $- != *i* ]] ; then
	return
fi

# Clear mouse reporting left enabled when SSH or a terminal app exits abruptly.
_reset_mouse_tracking() {
	local previous_exit_status=$?
	printf '\e[?1000;1002;1003;1006l'
	return "$previous_exit_status"
}

if [[ "${PROMPT_COMMAND[*]}" != *"_reset_mouse_tracking"* ]] ; then
	PROMPT_COMMAND+=(_reset_mouse_tracking)
fi
