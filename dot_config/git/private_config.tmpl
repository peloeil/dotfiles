[user]
    email = "{{.email }}"
    name = "{{.name }}"

[init]
    defaultBranch = main

[core]
    editor = nvim
    pager = delta

[commit]
    verbose = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true

[merge]
    conflictStyle = zdiff3

{{ $researchDir := .researchDir | trimSuffix "/" -}}
[includeIf "gitdir:{{ $researchDir }}/"]
    path = "{{ .chezmoi.homeDir }}/.config/git/research.config"
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
