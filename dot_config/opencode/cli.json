{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "mode": "dark"
  },
  "cursor": {
    "blinking": false
  },
  "prompt": {
    "paste": "full"
  },
  "session": {
    "thinking": "show",
    "grouping": "none",
    "image_preview": true,
    "permissions": "autoaccept"
  },
  "tabs": {
    "layout": "vertical"
  },
  "attention": {
    "notifications": true
  }
}
